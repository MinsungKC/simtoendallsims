// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`LemLib generator > matches the golden snapshot 1`] = `
"#include "main.h"
#include "lemlib/api.hpp" // IWYU pragma: keep

// Generated by SimToEndAllSims - routine: Test Route

pros::Controller controller(pros::E_CONTROLLER_MASTER);

// drivetrain motors (negative port = reversed)
pros::MotorGroup left_motors({-1, -2}, pros::MotorGears::blue);
pros::MotorGroup right_motors({3, 4}, pros::MotorGears::blue);
pros::MotorGroup intake({9}, pros::MotorGears::blue);
pros::adi::DigitalOut clamp_piston('A');

pros::Imu imu(10);
pros::Rotation vertical_1_encoder(11);
lemlib::TrackingWheel vertical_1_wheel(&vertical_1_encoder, lemlib::Omniwheel::NEW_275, -2.5);
pros::Rotation horizontal_2_encoder(12);
lemlib::TrackingWheel horizontal_2_wheel(&horizontal_2_encoder, lemlib::Omniwheel::NEW_275, -5.75);

// drivetrain settings
lemlib::Drivetrain drivetrain(&left_motors, // left motor group
                              &right_motors, // right motor group
                              12.5, // track width (in)
                              lemlib::Omniwheel::NEW_325, // wheel diameter
                              450, // wheel rpm = 600 x 36/48
                              8 // horizontal drift
);

lemlib::ControllerSettings lateral_controller(10, // kP
                                              0, // kI
                                              3, // kD
                                              3, // anti windup
                                              1, // small error range
                                              100, // small error timeout (ms)
                                              3, // large error range
                                              500, // large error timeout (ms)
                                              20 // slew
);

lemlib::ControllerSettings angular_controller(2, // kP
                                              0, // kI
                                              10, // kD
                                              3, // anti windup
                                              1, // small error range
                                              100, // small error timeout (ms)
                                              3, // large error range
                                              500, // large error timeout (ms)
                                              0 // slew
);

lemlib::OdomSensors sensors(&vertical_1_wheel, // vertical tracking wheel 1 (nullptr = drive motor encoders)
                            nullptr, // vertical tracking wheel 2
                            &horizontal_2_wheel, // horizontal tracking wheel 1
                            nullptr, // horizontal tracking wheel 2
                            &imu // inertial sensor
);

lemlib::Chassis chassis(drivetrain, lateral_controller, angular_controller, sensors);

ASSET(path_1_txt); // static/path_1.txt

void initialize() {
    pros::lcd::initialize();
    chassis.calibrate(); // calibrate sensors
    pros::Task screen_task([&]() {
        while (true) {
            pros::lcd::print(0, "X: %f", chassis.getPose().x);
            pros::lcd::print(1, "Y: %f", chassis.getPose().y);
            pros::lcd::print(2, "Theta: %f", chassis.getPose().theta);
            pros::delay(50);
        }
    });
}

void disabled() {}
void competition_initialize() {}

void autonomous() {
    // 1. Set start pose (-48, -58, 0°)
    chassis.setPose(-48, -58, 0);
    // 2. Drive to (-48, -30)
    intake.move(127);
    chassis.moveToPoint(-48, -30, 2500, {.maxSpeed = 100});
    chassis.waitUntil(20); // inches traveled
    clamp_piston.set_value(true);
    chassis.waitUntilDone();
    // 3. Turn to 90°
    chassis.turnToHeading(90, 2000, {.direction = lemlib::AngularDirection::CW_CLOCKWISE});
    chassis.waitUntilDone();
    // 4. Reverse to pose (-24, -24, 135°)
    chassis.moveToPose(-24, -24, 135, 4000, {.forwards = false, .lead = 0.5, .minSpeed = 40, .earlyExitRange = 4});
    chassis.waitUntilDone();
    intake.move(0);
    // 5. Swing to 180° (lock left)
    chassis.swingToHeading(180, lemlib::DriveSide::LEFT, 2000);
    chassis.waitUntilDone();
    // 6. Turn to face (0, 24)
    chassis.turnToPoint(0, 24, 2000);
    chassis.waitUntilDone();
    // 7. Follow path (1 segment)
    chassis.follow(path_1_txt, 12, 4000, true);
    pros::delay(400);
    intake.move(-127);
    pros::delay(250);
    intake.move(0);
    chassis.waitUntilDone();
    // 8. Wait 500 ms
    pros::delay(500);
    clamp_piston.set_value(false);
    // custom code here
}

void opcontrol() {
    bool clamp_on = false;
    while (true) {
        chassis.arcade(controller.get_analog(ANALOG_LEFT_Y), controller.get_analog(ANALOG_RIGHT_X));
        if (controller.get_digital(DIGITAL_R1)) intake.move(127);
        else if (controller.get_digital(DIGITAL_R2)) intake.move(-127);
        else intake.move(0);
        if (controller.get_digital_new_press(DIGITAL_L1)) {
            clamp_on = !clamp_on;
            clamp_piston.set_value(clamp_on);
        }
        pros::delay(10);
    }
}
"
`;
