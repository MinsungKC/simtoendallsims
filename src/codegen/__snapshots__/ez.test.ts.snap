exports[`EZ-Template generator > matches the golden snapshot 1`] = `
"#include "main.h"

// Generated by SimToEndAllSims - routine: Test Route

void default_constants() {
  chassis.pid_drive_constants_set(10, 0, 3);         // fwd/rev, also used for odom
  chassis.pid_heading_constants_set(11.0, 0.0, 20.0);        // holds heading while driving straight (EZ default)
  chassis.pid_turn_constants_set(2, 0.05, 10, 15.0);  // turn in place
  chassis.pid_swing_constants_set(4, 0.0, 65);           // swing (EZ-scaled from the turn gains)
  chassis.pid_odom_angular_constants_set(6.5, 0.0, 52.5);    // angular control for odom motions (EZ default)
  chassis.pid_odom_boomerang_constants_set(5.8, 0.0, 32.5);  // boomerang angular control (EZ default)

  chassis.pid_turn_exit_condition_set(90_ms, 1_deg, 250_ms, 3_deg, 500_ms, 500_ms);
  chassis.pid_swing_exit_condition_set(90_ms, 1_deg, 250_ms, 3_deg, 500_ms, 500_ms);
  chassis.pid_drive_exit_condition_set(90_ms, 1_in, 250_ms, 3_in, 500_ms, 500_ms);
  chassis.pid_odom_turn_exit_condition_set(90_ms, 1_deg, 250_ms, 3_deg, 500_ms, 750_ms);
  chassis.pid_odom_drive_exit_condition_set(90_ms, 1_in, 250_ms, 3_in, 500_ms, 750_ms);
  chassis.pid_turn_chain_constant_set(3_deg);
  chassis.pid_swing_chain_constant_set(5_deg);
  chassis.pid_drive_chain_constant_set(3_in);

  chassis.slew_turn_constants_set(3_deg, 70);
  chassis.slew_drive_constants_set(3_in, 70);
  chassis.slew_swing_constants_set(3_in, 80);

  chassis.odom_turn_bias_set(0.9);
  chassis.odom_look_ahead_set(7_in);
  chassis.odom_boomerang_distance_set(16_in);
  chassis.odom_boomerang_dlead_set(0.625);

  chassis.pid_angle_behavior_set(ez::shortest);
}

void auton_1() {
    // 1. Set start pose (-48, -58, 0°)
    chassis.odom_xyt_set(-48_in, -58_in, 0_deg);
    chassis.drive_imu_reset(0);
    // 2. Drive to (-48, -30)
    intake.move(127);
    chassis.pid_odom_set({{-48_in, -30_in}, fwd, 100}, true);
    chassis.pid_wait_until(20_in);
    clamp_piston.set_value(true);
    chassis.pid_wait();
    // 3. Turn to 90°
    chassis.pid_turn_set(90_deg, 127, ez::cw);
    chassis.pid_wait();
    // 4. Reverse to pose (-24, -24, 135°)
    chassis.pid_odom_set({{-24_in, -24_in, 135_deg}, rev, 127}, true);
    chassis.pid_wait();
    intake.move(0);
    // 5. Swing to 180° (lock left)
    chassis.pid_swing_set(ez::RIGHT_SWING, 180_deg, 127);
    chassis.pid_wait();
    // 6. Turn to face (0, 24)
    chassis.pid_turn_set({0_in, 24_in}, fwd, 127);
    chassis.pid_wait();
    // 7. Follow path (1 segment)
    chassis.pid_odom_set({{{-21.651_in, -14.594_in}, fwd, 49},
                          {{-15.797_in, -6.82_in}, fwd, 43},
                          {{-7.623_in, -1.546_in}, fwd, 35},
                          {{0_in, 0_in}, fwd, 30}}, true);
    pros::delay(400);
    intake.move(-127);
    pros::delay(250);
    intake.move(0);
    chassis.pid_wait();
    // 8. Wait 500 ms
    pros::delay(500);
    clamp_piston.set_value(false);
    // custom code here
}
"
`;

exports[`EZ-Template generator > matches the golden snapshot 2`] = `
"#include "main.h"

// Chassis constructor
ez::Drive chassis(
    {-1, -2},  // left chassis ports (negative = reversed)
    {3, 4},  // right chassis ports (negative = reversed)
    10,  // IMU port
    3.25,  // wheel diameter (actual size)
    450);  // wheel RPM = cartridge 600 x 36/48

ez::tracking_wheel vert_tracker_1(11, 2.75, 2.5);
ez::tracking_wheel horiz_tracker_2(12, 2.75, 5.75);

void initialize() {
  ez::ez_template_print();
  pros::delay(500);

  chassis.odom_tracker_left_set(&vert_tracker_1);
  chassis.odom_tracker_back_set(&horiz_tracker_2);

  chassis.opcontrol_curve_buttons_toggle(true);
  chassis.opcontrol_drive_activebrake_set(0.0);
  chassis.opcontrol_curve_default_set(0.0, 0.0);

  default_constants();

  ez::as::auton_selector.autons_add({
      {"Test Route\\n\\nGenerated by SimToEndAllSims", auton_1},
  });

  chassis.initialize();
  ez::as::initialize();
  master.rumble(chassis.drive_imu_calibrated() ? "." : "---");
}

void disabled() {}
void competition_initialize() {}

void autonomous() {
  chassis.pid_targets_reset();
  chassis.drive_imu_reset();
  chassis.drive_sensor_reset();
  chassis.drive_brake_set(MOTOR_BRAKE_HOLD);

  ez::as::auton_selector.selected_auton_call();
}

void opcontrol() {
  chassis.drive_brake_set(MOTOR_BRAKE_BRAKE);
  bool clamp_on = false;
  while (true) {
    chassis.opcontrol_arcade_standard(ez::SPLIT);
    if (master.get_digital(DIGITAL_R1)) intake.move(127);
    else if (master.get_digital(DIGITAL_R2)) intake.move(-127);
    else intake.move(0);
    if (master.get_digital_new_press(DIGITAL_L1)) {
      clamp_on = !clamp_on;
      clamp_piston.set_value(clamp_on);
    }
    pros::delay(ez::util::DELAY_TIME);
  }
}
"
`;
