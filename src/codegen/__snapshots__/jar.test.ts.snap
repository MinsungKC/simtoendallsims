exports[`JAR-Template generator > matches the golden snapshot 1`] = `
"#include "vex.h"

// Generated by SimToEndAllSims - routine: Test Route

void default_constants() {
  // (maxVoltage, kP, kI, kD, startI) - gains are LemLib-tuned values x 12/127
  chassis.set_drive_constants(10, 0.945, 0, 0.283, 0);
  chassis.set_heading_constants(6, .4, 0, 1, 0);
  chassis.set_turn_constants(12, 0.189, 0.002, 0.945, 15);
  chassis.set_swing_constants(12, 0.189, 0.002, 0.945, 15);

  // (settle_error, settle_time, timeout)
  chassis.set_drive_exit_conditions(1.5, 300, 5000);
  chassis.set_turn_exit_conditions(1, 300, 3000);
  chassis.set_swing_exit_conditions(1, 300, 3000);
}

void odom_constants() {
  default_constants();
  chassis.heading_max_voltage = 10;
  chassis.drive_max_voltage = 8;
  chassis.drive_settle_error = 3;
  chassis.boomerang_lead = 0.5;
  chassis.drive_min_voltage = 0;
}

// Mechanism stubs - fill these in with your robot's code.
// TODO: score the held object onto the Goal in front of the robot (the simulator nests it onto the stack)
void place_on_goal() {}

// TODO: flip the Toggle in front of the robot to blue
void set_toggle_blue() {}

void auton_1_step2_actions() {
  wait(900, msec); // ~when the simulated robot had traveled 20 (re-time on robot)
  clamp_piston.open();
}

void auton_1_step7_actions() {
  wait(400, msec); // delay
  intake.spin(reverse, 12, volt);
  wait(250, msec);
  intake.stop();
}

void auton_1() {
  odom_constants();
  // 1. Set start pose (-48, -58, 0°)
  chassis.set_coordinates(-48, -58, 0);
  // 2. Drive to (-48, -30)
  intake.spin(fwd, 12, volt);
  thread auton_1_step2_actions_thread(auton_1_step2_actions);
  chassis.drive_to_point(-48, -30, 0, 9.4, 9.4, 3, 300, 2500);
  // 3. Turn to 90°
  chassis.turn_to_angle(90, 12, 1, 300, 2000);
  // 4. Reverse to pose (-24, -24, 135°)
  chassis.drive_to_pose(-24, -24, 135, 0.5, 2, 3.8, 12, 10, 3, 300, 4000);
  intake.stop();
  // 5. Swing to 180° (lock left)
  chassis.right_swing_to_angle(180, 12, 1, 300, 2000, 0.189, 0.002, 0.945, 15);
  // 6. Turn to face (0, 24)
  chassis.turn_to_point(0, 24, 0, 12, 1, 300, 2000);
  // 7. Follow path (1 segment)
  thread auton_1_step7_actions_thread(auton_1_step7_actions);
  chassis.drive_to_point(-20.71, -12.879, 2.7, 4.5, 10, 6, 0, 4000);
  chassis.drive_to_point(-12.762, -4.355, 2.28, 3.8, 10, 6, 0, 4000);
  chassis.drive_to_point(-1.953, -0.104, 1.68, 2.8, 10, 6, 0, 4000);
  chassis.drive_to_point(0, 0, 0, 2.8, 10, 3, 300, 4000);
  // 8. Wait 500 ms
  wait(500, msec);
  clamp_piston.close();
  // custom code here
  place_on_goal();
  set_toggle_blue();
}
"
`;

exports[`JAR-Template generator > matches the golden snapshot 2`] = `
"#include "vex.h"

using namespace vex;
competition Competition;

Drive chassis(
    TANK_TWO_ROTATION,
    motor_group(L1, L2),  // left motors
    motor_group(R1, R2),  // right motors
    PORT10,  // inertial sensor
    3.25,  // wheel diameter (actual size)
    0.75,  // external ratio = driving teeth / driven teeth (36/48)
    360,  // gyro scale
    PORT1, -PORT2, PORT3, -PORT4,  // holonomic drives only (unused for tank)
    PORT11,  // forward tracker port
    2.75,  // forward tracker diameter
    -2.5,  // forward tracker center distance (+ = right of center)
    PORT12,  // sideways tracker port
    2.75,  // sideways tracker diameter
    5.75  // sideways tracker center distance (+ = behind center)
);

void pre_auton() {
  vexcodeInit();
  default_constants();
  Brain.Screen.clearScreen();
  Brain.Screen.printAt(5, 20, "Test Route");
}

void autonomous(void) {
  auton_1();
}

void usercontrol(void) {
  while (1) {
    chassis.control_arcade();
    if (Controller1.ButtonR1.pressing()) intake.spin(fwd, 12, volt);
    else if (Controller1.ButtonR2.pressing()) intake.spin(reverse, 12, volt);
    else intake.stop();
    if (Controller1.ButtonL1.pressing()) clamp_piston.open();
    else if (Controller1.ButtonL2.pressing()) clamp_piston.close();
    wait(20, msec);
  }
}

int main() {
  Competition.autonomous(autonomous);
  Competition.drivercontrol(usercontrol);
  pre_auton();
  while (true) {
    wait(100, msec);
  }
}
"
`;
